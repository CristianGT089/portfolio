---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import VigiaNova from '../components/VigiaNova.astro';
import Experience from '../components/Experience.astro';
import Recognition from '../components/Recognition.astro';
import Community from '../components/Community.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { PROFILE, CURRENT_ROLE, CURRENT_COMPANY } from '../data/profile';

const title = `${PROFILE.name} — ${CURRENT_ROLE} at ${CURRENT_COMPANY}`;
const description = `${PROFILE.name}, systems engineer in Bogotá. ${CURRENT_ROLE} at ${CURRENT_COMPANY}: building a multi-tenant accounting and tax-control SaaS with FastAPI, Next.js and PostgreSQL. Previously backend and AI workflows at Evaluar.com.`;
---

<Layout title={title} description={description}>
	<Nav />
	<main id="main">
		<Hero />
		<VigiaNova />
		<Experience />
		<Recognition />
		<Community />
		<About />
		<Contact />
	</main>
</Layout>
