---
import SectionHeading from './SectionHeading.astro';
import { EXPERIENCE } from '../data/profile';
---

<section id="experience" class="mx-auto max-w-page px-4 py-14 sm:px-6 md:py-20 lg:px-8">
	<SectionHeading index="02" title="Experience" />

	<ol class="relative">
		{
			EXPERIENCE.map(({ period, role, company, description, tags }, i) => (
				<li class="relative grid gap-2 border-l-2 border-line pb-10 pl-6 last:pb-0 md:grid-cols-12 md:gap-8 md:border-l-0 md:pl-0" data-reveal>
					<span
						class:list={[
							'absolute -left-[7px] top-1.5 size-3 rounded-full ring-4 ring-paper md:hidden',
							i === 0 ? 'bg-accent' : 'bg-line',
						]}
						aria-hidden="true"
					/>
					<p class="text-muted md:col-span-3 md:pt-1">{period}</p>
					<div class="md:col-span-9 md:border-l-2 md:border-line md:pl-8 md:relative">
						<span
							class:list={[
								'absolute -left-[7px] top-2 hidden size-3 rounded-full ring-4 ring-paper md:block',
								i === 0 ? 'bg-accent' : 'bg-line',
							]}
							aria-hidden="true"
						/>
						<h3 class="text-[1.375rem] font-bold leading-snug">
							{company}
							<span class="block text-lg font-semibold text-accent">{role}</span>
						</h3>
						<p class="mt-3 max-w-2xl text-pretty leading-relaxed text-muted">{description}</p>
						<p class="mt-3 text-sm font-semibold text-ink/70">{tags.join(' · ')}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
