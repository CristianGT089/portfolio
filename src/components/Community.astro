---
import SectionHeading from './SectionHeading.astro';
import { COMMUNITY } from '../data/profile';
---

<section id="community" class="mx-auto max-w-page px-4 py-14 sm:px-6 md:py-20 lg:px-8">
	<SectionHeading index="04" title="Community" note="Free software is where I learned to lead: teaching, organizing and building in the open." />

	<ol class="grid gap-x-12 gap-y-10 md:grid-cols-2">
		{
			COMMUNITY.map(({ period, role, org, description }, i) => (
				<li class="border-t-2 border-line pt-5" data-reveal style={`--delay: ${(i % 2) * 70}ms`}>
					<p class="text-sm text-muted">{period}</p>
					<h3 class="mt-1 text-xl font-bold">{org}</h3>
					<p class="font-semibold text-accent">{role}</p>
					<p class="mt-3 text-pretty leading-relaxed text-muted">{description}</p>
				</li>
			))
		}
	</ol>
</section>
