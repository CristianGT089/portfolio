---
interface Props {
	name: 'arrow-up-right' | 'arrow-down' | 'arrow-up' | 'mail' | 'github' | 'linkedin' | 'sun' | 'moon' | 'copy' | 'check';
	class?: string;
}
const { name, class: className = 'size-4' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
	{name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
	{name === 'arrow-up' && <path d="M12 19V5M6 11l6-6 6 6" />}
	{name === 'mail' && (
		<>
			<rect x="3" y="5" width="18" height="14" rx="2.5" />
			<path d="m4 7 8 6 8-6" />
		</>
	)}
	{name === 'github' && (
		<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
	)}
	{name === 'linkedin' && (
		<>
			<rect x="3" y="3" width="18" height="18" rx="3" />
			<path d="M8 10.5V16M8 7.5v.01M12 16v-5.5M12 13a2.5 2.5 0 0 1 5 0v3" />
		</>
	)}
	{name === 'sun' && (
		<>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
		</>
	)}
	{name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />}
	{name === 'copy' && (
		<>
			<rect x="9" y="9" width="11" height="11" rx="2" />
			<path d="M5 15V6a2 2 0 0 1 2-2h8" />
		</>
	)}
	{name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
