---
// Igual que \section en estilo-cristian.sty: número grande en rojo suave junto al título.
interface Props {
	index: string;
	title: string;
	note?: string;
}
const { index, title, note } = Astro.props;
---

<header class="mb-10 md:mb-14" data-reveal>
	<h2 class="flex items-baseline gap-3 md:gap-4">
		<span class="text-[2.75rem] font-bold leading-none tabular-nums text-accent/35 md:text-[3.75rem]" aria-hidden="true">{index}</span>
		<span class="text-[1.75rem] font-bold leading-tight tracking-[-0.015em] md:text-[2.375rem]">{title}</span>
	</h2>
	{note && <p class="mt-3 max-w-2xl text-pretty text-lg text-muted">{note}</p>}
</header>
