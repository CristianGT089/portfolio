---
// Marca personal: la «C» geométrica con el punto carmesí (la misma del favicon).
interface Props {
	class?: string;
}
const { class: className = 'size-9' } = Astro.props;
---

<svg class:list={['shrink-0', className]} viewBox="0 0 64 64" aria-hidden="true">
	<rect width="64" height="64" rx="15" fill="#2E3338"></rect>
	<path d="M44.7 19.3A18 18 0 1 0 44.7 44.7" fill="none" stroke="#fff" stroke-width="9.5" stroke-linecap="round"></path>
	<circle cx="46.5" cy="32" r="7.5" fill="#A4161A"></circle>
</svg>
